DATABASE_URL=postgres://user:password@localhost:5432/projectflow

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=projectflow-fotos
S3_REGION=us-east-1

ANTHROPIC_API_KEY=
ASSISTENTE_IA_ATIVO=false

# Envio de email (recuperação de senha). Sem RESEND_API_KEY, o link só é logado no
# console do servidor em vez de ser enviado de verdade — útil pra testar localmente.
RESEND_API_KEY=
EMAIL_FROM=ProjectFlow <onboarding@resend.dev>
